{
  "description": "A repo whose committed .claude folder holds shared and local Claude Code settings, one workspace alpha, a Claude Code config folder with the user's own settings, hooks and state, a stand-in gh, and a stand-in Claude Code that takes one prompt and finishes, with Satellite set to the light theme.",
  "repo": [
    { "write": { "path": "README.md", "content": "# Verify repo\n" } },
    {
      "write": {
        "path": ".claude/settings.json",
        "content": "{\"permissions\":{\"allow\":[\"Bash(npm test)\"]}}"
      }
    },
    {
      "write": {
        "path": ".claude/settings.local.json",
        "content": "{\"permissions\":{\"allow\":[\"Bash(ls)\"]}}"
      }
    },
    { "git": ["init", "-b", "main"] },
    { "git": ["add", "--force", "."] },
    { "git": ["commit", "-m", "first commit"] }
  ],
  "home": [
    {
      "path": "interface.json",
      "content": "{\"version\":1,\"selected\":null,\"columns\":{\"left\":248,\"right\":440},\"theme\":\"light\"}"
    }
  ],
  "workspaces": [{ "name": "alpha", "steps": [] }],
  "claudeConfig": [
    {
      "path": "settings.json",
      "content": "{\"theme\":\"dark\",\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"exit 0\"}]}]}}"
    },
    { "path": ".claude.json", "content": "{\"projects\":{}}" }
  ],
  "gh": [
    { "args": ["--version"], "stdout": "gh version 2.99.0 (stand-in)\n" },
    {
      "args": ["auth", "status", "--active"],
      "stdout": "github.com\n  ✓ Logged in to github.com account octo-verify (keyring)\n  - Active account: true\n"
    }
  ],
  "claude": {
    "version": "2.0.0 (Claude Code stand-in)",
    "script": [
      { "print": "Claude Code stand-in\r\n" },
      { "print": "\u001b[?2004h" },
      { "hook": "SessionStart", "fields": { "source": "startup" } },
      { "print": "> " },
      { "await": "\r" },
      { "hook": "UserPromptSubmit" },
      { "hook": "Stop" },
      { "print": "Done.\r\n> " }
    ]
  }
}
