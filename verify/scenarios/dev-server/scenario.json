{
  "description": "A fresh repo whose stand-in Claude Code starts a dev server on a loopback port the system chose, with a child of its own, and ends a turn at each Enter, with Satellite set to the light theme.",
  "repo": [
    {
      "write": {
        "path": "README.md",
        "content": "# Verify repo\n"
      }
    },
    {
      "git": ["init", "-b", "main"]
    },
    {
      "git": ["add", "."]
    },
    {
      "git": ["commit", "-m", "first commit"]
    }
  ],
  "home": [
    {
      "path": "interface.json",
      "content": "{\"version\":1,\"selected\":null,\"columns\":{\"left\":248,\"right\":440},\"theme\":\"light\"}"
    }
  ],
  "workspaces": [],
  "gh": [
    {
      "args": ["--version"],
      "stdout": "gh version 2.99.0 (stand-in)\n"
    },
    {
      "args": ["auth", "status", "--active"],
      "stdout": "github.com\n  ✓ Logged in to github.com account octo-verify (keyring)\n  - Active account: true\n"
    }
  ],
  "claude": {
    "version": "2.1.78 (Claude Code stand-in)",
    "script": [
      {
        "print": "Claude Code stand-in\r\n"
      },
      {
        "child": "dev-server"
      },
      {
        "print": "> "
      },
      {
        "await": "\r"
      },
      {
        "hook": "UserPromptSubmit"
      },
      {
        "hook": "Stop"
      },
      {
        "print": "\r\nReady.\r\n> "
      },
      {
        "await": "\r"
      },
      {
        "hook": "UserPromptSubmit"
      },
      {
        "hook": "Stop"
      },
      {
        "print": "\r\nReady.\r\n> "
      },
      {
        "await": "\r"
      },
      {
        "hook": "UserPromptSubmit"
      },
      {
        "hook": "Stop"
      },
      {
        "print": "\r\nReady.\r\n> "
      }
    ]
  }
}
