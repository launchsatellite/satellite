#!/bin/sh
# The green checkpoint. Agents and CI run it before calling a change done. Every step runs even
# after one fails, so one run reports everything that is wrong.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 2
failed=""
run() {
  name=$1
  shift
  printf '\n==> %s\n' "$name"
  "$@" || failed="$failed $name"
}

run guards ./guards/check.sh files
run guard-tests ./guards/test.sh
run format npm run --silent format:check
run lint npm run --silent lint
run typecheck npm run --silent typecheck
run tests npm run --silent test

echo
[ -z "$failed" ] || { echo "check: FAILED:$failed"; exit 1; }
echo "check: all green"
