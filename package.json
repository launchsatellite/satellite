{
  "name": "satellite",
  "productName": "Satellite",
  "version": "0.1.0",
  "private": true,
  "author": "Satellite",
  "type": "module",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "verify": "node verify/cli.ts",
    "journeys": "node verify/journeys.ts",
    "postinstall": "node scripts/postinstall.ts"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/funnel-sans": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/geist-pixel": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "monaco-editor": "0.57.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
